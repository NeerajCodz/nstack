# Web-only environment values for apps/web
# Browser-visible Convex deployment URL (https://<deployment>.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=
# Public origin hosting this Next.js app
NEXT_PUBLIC_SITE_URL=

# CLI runtime values (set in the user's shell, not in a repository credential file)
NSTACK_LINEAR_CONVEX_URL=
NSTACK_LINEAR_WEB_URL=

# Convex deployment secrets (set with `bun run --bun convex:dev` / `bun run --bun convex:deploy` env configuration)
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=
LINEAR_TOKEN_ENCRYPTION_KEY=
# Public connect-page base URL, matching NEXT_PUBLIC_SITE_URL
LINEAR_CONNECT_URL=
