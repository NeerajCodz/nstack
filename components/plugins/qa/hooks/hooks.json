{
  "description": "QA plugin hooks",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/run-tests.mjs",
            "args": [],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
